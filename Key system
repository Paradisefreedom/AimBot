-- ============ KEY STORAGE ============
local ActivatedKeys = {}

local function loadActivatedKeys()
    if writefile and readfile and isfile then
        if isfile("keysystem_data.json") then
            local success, data = pcall(function()
                return game:GetService("HttpService"):JSONDecode(readfile("keysystem_data.json"))
            end)
            if success and data then
                ActivatedKeys = data
            end
        end
    end
end

local function saveActivatedKeys()
    if writefile then
        pcall(function()
            writefile("keysystem_data.json", game:GetService("HttpService"):JSONEncode(ActivatedKeys))
        end)
    end
end

-- ============ KEY VALIDATION ============
local function validateKey(inputKey)
    local keyInfo = KEY_DATABASE[inputKey]

    if not keyInfo then
        return false, "Invalid key."
    end

    if keyInfo == "never" then
        return true, "Key accepted (never expires)."
    end

    local activationTime = ActivatedKeys[inputKey]

    if activationTime then
        local elapsed = os.time() - activationTime
        if elapsed >= EXPIRY_TIMES[keyInfo] then
            return false, "Key has expired."
        end
        return true, "Key still valid."
    else
        ActivatedKeys[inputKey] = os.time()
        saveActivatedKeys()
        return true, "Key activated successfully!"
    end
end

-- ============ OPEN URL HELPER ============
local function openKeyLink()
    -- Try known executor methods to open a browser
    local opened = false

    -- Some executors expose these
    for _, fn in ipairs({
        function() return request and request({Url = KEY_LINK, Method = "GET"}) end,
        function() return http_request and http_request({Url = KEY_LINK, Method = "GET"}) end,
        function() return syn and syn.request and syn.request({Url = KEY_LINK, Method = "GET"}) end,
    }) do
        local ok = pcall(fn)
        if ok then opened = true break end
    end

    -- Always copy to clipboard as a reliable fallback
    pcall(function() setclipboard(KEY_LINK) end)

    return opened
end

