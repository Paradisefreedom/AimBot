-- Helper function to create Toggles
local function createToggle(text, stateKey)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 220, 0, 35)
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    button.Text = text .. " : OFF"
    button.TextColor3 = Color3.fromRGB(200, 200, 200)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 13
    button.AutoButtonColor = false
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = button

    button.MouseButton1Click:Connect(function()
        state[stateKey] = not state[stateKey]
        if state[stateKey] then
            button.BackgroundColor3 = Color3.fromRGB(0, 170, 100) -- Green
            button.Text = text .. " : ON"
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            button.BackgroundColor3 = Color3.fromRGB(40, 40, 40) -- Dark Gray
            button.Text = text .. " : OFF"
            button.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        -- Add your backend toggle logic here
        print(text .. " set to " .. tostring(state[stateKey]))
    end)
    
    return button
end

-- Helper function to create Inputs (FOV, Smoothness)
local function createInput(text, stateKey, defaultValue)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 35)
    frame.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.4, 0, 1, 0)
    box.Position = UDim2.new(0.6, 0, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    box.Text = tostring(defaultValue)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.Parent = frame
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = box
    
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            state[stateKey] = num
            print(text .. " updated to: " .. num)
            -- Add your backend value update logic here
        else
            box.Text = tostring(state[stateKey]) -- Revert if invalid input
        end
    end)
    
    return frame
end

