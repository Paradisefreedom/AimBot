-- --- AIMBOT BACKEND LOGIC --- --

-- Function to find the closest player to the mouse inside the FOV
local function getClosestPlayerInFOV()
    local mousePos = UserInputService:GetMouseLocation()
    local closestDist = state.FOV
    local closestPlr = nil

    for _, targetPlr in ipairs(Players:GetPlayers()) do
        if targetPlr ~= player and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") and targetPlr.Character:FindFirstChild("Humanoid") then
            if targetPlr.Character.Humanoid.Health > 0 then
                local hrp = targetPlr.Character.HumanoidRootPart
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    -- Calculate distance from mouse to target's screen position
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPlr = targetPlr
                    end
                end
            end
        end
    end
    return closestPlr
end

-- Listen for keybind presses (Hold to aim)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if state.IsBinding and input.UserInputType == Enum.UserInputType.Keyboard then
        state.AimKeybind = input.KeyCode
        state.IsBinding = false
        keybindBtn.Text = "Aim Keybind : " .. state.AimKeybind.Name
        keybindBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    elseif not gameProcessed then
        if input.KeyCode == state.AimKeybind and state.AimEnabled then
            aiming = true
            if state.TargetLock then
                currentTarget = getClosestPlayerInFOV()
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == state.AimKeybind then
        aiming = false
        currentTarget = nil
    end
end)

-- The actual aim loop that updates camera position
RunService.RenderStepped:Connect(function()
    -- Update FOV Circle position and size dynamically
    if state.AimEnabled then
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
        fovCircle.Size = UDim2.new(0, state.FOV * 2, 0, state.FOV * 2)
    end

    if state.AimEnabled and aiming then
        local targetToAimAt = nil

        if state.TargetLock then
            -- Verify if the locked target is still alive and has a RootPart
            if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") and currentTarget.Character.Humanoid.Health > 0 then
                targetToAimAt = currentTarget
            else
                currentTarget = getClosestPlayerInFOV() -- Find a new one if old one dies
                targetToAimAt = currentTarget
            end
        else
            -- Continuously update to whoever is closest in FOV
            targetToAimAt = getClosestPlayerInFOV()
        end

        -- Move the camera
        if targetToAimAt then
            local targetHRP = targetToAimAt.Character.HumanoidRootPart
            -- Calculate the exact CFrame looking at the HumanoidRootPart
            local targetCameraCFrame = CFrame.new(camera.CFrame.Position, targetHRP.Position)
            
            -- Apply Smoothness using Lerp
            -- state.Smoothness clamped between 0 and 1 so it doesn't break
            local smoothFactor = math.clamp(state.Smoothness, 0.01, 1) 
            camera.CFrame = camera.CFrame:Lerp(targetCameraCFrame, smoothFactor)
        end
    end
end)
