-- Services
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui") -- Use game.Players.LocalPlayer.PlayerGui if Testing in Studio

-- Main UI Setup
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MinimalAimUI"
ScreenGui.ResetOnSpawn = false

-- Try to protect UI if in game, otherwise default to PlayerGui
local player = Players.LocalPlayer
local targetGui = player:WaitForChild("PlayerGui")
ScreenGui.Parent = targetGui

-- Main Frame
local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 250, 0, 200)
Frame.Position = UDim2.new(0.05, 0, 0.3, 0)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true -- Allows you to move the UI around for testing
Frame.Parent = ScreenGui

-- UI Corner for modern smooth edges
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = Frame

-- Title
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Text = "AIM CONFIG"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18
Title.Parent = Frame

-- State variables for your aimlock logic
local Settings = {
    TargetLock = false,
    FOV = 70,
    Smoothness = 5
}

-- 1. TOGGLE BUTTON
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0, 210, 0, 35)
ToggleBtn.Position = UDim2.new(0, 20, 0, 45)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50) -- Default Red (Off)
ToggleBtn.Text = "Target Lock: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.SourceSansSemibold
ToggleBtn.TextSize = 16
ToggleBtn.Parent = Frame

local ToggleCorner = Instance.new("UICorner")
ToggleCorner.CornerRadius = UDim.new(0, 6)
ToggleCorner.Parent = ToggleBtn

ToggleBtn.MouseButton1Click:Connect(function()
    Settings.TargetLock = not Settings.TargetLock
    if Settings.TargetLock then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50) -- Green (On)
        ToggleBtn.Text = "Target Lock: ON"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50) -- Red (Off)
        ToggleBtn.Text = "Target Lock: OFF"
    end
    print("Target Lock:", Settings.TargetLock)
end)

-- 2. FOV SLIDER (Simple Text/Box Input for absolute cleanliness)
local FOVLabel = Instance.new("TextLabel")
FOVLabel.Size = UDim2.new(0, 100, 0, 30)
FOVLabel.Position = UDim2.new(0, 20, 0, 95)
FOVLabel.BackgroundTransparency = 1
FOVLabel.Text = "FOV Radius:"
FOVLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
FOVLabel.Font = Enum.Font.SourceSans
FOVLabel.TextSize = 16
FOVLabel.TextXAlignment = Enum.TextXAlignment.Left
FOVLabel.Parent = Frame

local FOVInput = Instance.new("TextBox")
FOVInput.Size = UDim2.new(0, 100, 0, 30)
FOVInput.Position = UDim2.new(0, 130, 0, 95)
FOVInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
FOVInput.Text = tostring(Settings.FOV)
FOVInput.TextColor3 = Color3.fromRGB(255, 255, 255)
FOVInput.Font = Enum.Font.SourceSans
FOVInput.TextSize = 16
FOVInput.Parent = Frame

local FOVCorner = Instance.new("UICorner")
FOVCorner.CornerRadius = UDim.new(0, 4)
FOVCorner.Parent = FOVInput

FOVInput.FocusLost:Connect(function(enterPressed)
    local num = tonumber(FOVInput.Text)
    if num then
        Settings.FOV = math.clamp(num, 1, 360)
        FOVInput.Text = tostring(Settings.FOV)
        print("FOV set to:", Settings.FOV)
    else
        FOVInput.Text = tostring(Settings.FOV)
    end
end)

